generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum PlanType {
  FREE
  STARTER
  PRO
  PRO_YEARLY
  ENTERPRISE
}

enum SubStatus {
  INACTIVE
  ACTIVE
  CANCELLED
}

enum BillingCycle {
  MONTHLY
  QUARTERLY
  YEARLY
}

/// Peran anggota dalam sebuah organisasi.
enum OrgRole {
  OWNER
  EDITOR
  VIEWER
}

/// Status undangan anggota.
enum InviteStatus {
  PENDING
  ACCEPTED
  REVOKED
}

/// Organisasi tim — wadah kolaborasi (fitur ENTERPRISE).
/// Workspace dapat dimiliki organisasi, sehingga seluruh anggotanya
/// mendapat akses, bukan hanya pembuatnya.
model Organization {
  id           String             @id @default(uuid())
  name         String
  slug         String             @unique
  ownerId      String
  owner        User               @relation("OrgOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  /// Jumlah seat yang diizinkan. Default 3 sesuai paket Enterprise.
  seatLimit    Int                @default(3)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  members      Membership[]
  invites      OrganizationInvite[]
  workspaces   Workspace[]

  @@index([ownerId])
}

/// Keanggotaan user di organisasi (1 user = 1 peran per organisasi).
model Membership {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           OrgRole      @default(VIEWER)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, userId])
  @@index([userId])
}

/// Undangan anggota. Bila email belum terdaftar, undangan tetap PENDING
/// dan aktif otomatis saat orang itu login (dicek di callback auth).
model OrganizationInvite {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           OrgRole      @default(VIEWER)
  status         InviteStatus @default(PENDING)
  invitedById    String?
  createdAt      DateTime     @default(now())
  respondedAt    DateTime?

  @@unique([organizationId, email])
  @@index([email, status])
}

model Plan {
  id              String   @id @default(uuid())
  code            String   @unique // 'FREE' | 'STARTER' | 'PRO' (map ke PlanType)
  name            String
  description     String?
  priceMonthly    Int      @default(0) // IDR
  priceYearly     Int      @default(0) // IDR
  discountPercent Int      @default(0) // diskon tambahan dari admin
  prdLimit        Int      @default(1) // -1 = unlimited
  prototypeLimit  Int      @default(0) // kuota generate Prototype Design/bln (-1 = unlimited)
  features        String[] @default([])
  isActive        Boolean  @default(true)
  isPopular       Boolean  @default(false)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  name          String?
  avatarUrl     String?
  role          Role           @default(USER)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  subscription  Subscription?
  workspaces    Workspace[]
  apiKeys       ApiKey[]
  transactions  Transaction[]
  savedThemes   SavedTheme[]
  chatThreads   ChatThread[]
  consultThreads ConsultThread[]
  ownedOrgs     Organization[]       @relation("OrgOwner")
  memberships   Membership[]
}

model Subscription {
  id                  String       @id @default(uuid())
  userId              String       @unique
  user                User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  planType            PlanType     @default(FREE)
  status              SubStatus    @default(INACTIVE)
  billingCycle        BillingCycle @default(MONTHLY)
  prdLimit            Int          @default(1)
  chatLimit           Int          @default(0)
  prdUsedThisMonth    Int          @default(0)
  chatUsedThisMonth   Int          @default(0)
  // Kuota generate Prototype Design (-1 = unlimited).
  // HTML jauh lebih mahal daripada Markdown, jadi kuotanya terpisah.
  prototypeLimit       Int         @default(0)
  prototypeUsedThisMonth Int       @default(0)
  startedAt           DateTime?
  validUntil          DateTime?
  updatedAt           DateTime     @updatedAt
}

model Workspace {
  id                  String       @id @default(uuid())
  userId              String
  user                User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Bila diisi, workspace ini milik organisasi dan dapat diakses
  /// seluruh anggotanya. `userId` tetap dipertahankan sebagai pembuat.
  organizationId      String?
  organization        Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  title               String
  description         String?
  locale              String       @default("id") // 'id' | 'en' — bahasa output AI
  techStack           Json
  techPreferences     Json?        // { mode: 'ai'|'manual', frontend, backend, database, deployment }
  mindmapJson         Json
  fullPrdMd           String?
  tasksJson           Json?        // Task breakdown dari PRD
  styleGuideMd        String?      // Style guide (design system)

  // Prototype Design (PRO) — HTML mandiri + struktur screen + token tema.
  prototypeHtml       String?      // HTML/CSS/JS self-contained, dirender di iframe
  prototypeJson       Json?        // { screens: [{id,label,order}], generatedAt }
  themeTokensJson     Json?        // token tema tersimpan (warna, tipografi, bentuk)
  prototypeVersions   PrototypeVersion[]
  prdVersions         PrdVersion[]
  chatThreads         ChatThread[]
  consultThreads      ConsultThread[]

  isPublic            Boolean      @default(false)
  isAnonymous         Boolean      @default(false)
  shareSlug           String?      @unique
  category            String?

  forkedFromId        String?
  originalWorkspace   Workspace?   @relation("WorkspaceForks", fields: [forkedFromId], references: [id], onDelete: SetNull)
  forks               Workspace[]  @relation("WorkspaceForks")
  viewsCount          Int          @default(0)
  forksCount          Int          @default(0)

  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
}

/// Riwayat prototype — agar regenerate tidak menimpa versi lama secara permanen.
/// Disimpan maksimal N versi terakhir per workspace (dipangkas saat menyimpan).
model PrototypeVersion {
  id          String   @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  html        String
  screens     Json?
  note        String?
  createdAt   DateTime @default(now())

  @@index([workspaceId, createdAt])
}

/// Riwayat versi PRD — agar perubahan (mis. "perbaiki section" dari Konsultasi AI
/// atau regenerate ulang) tidak menimpa versi lama secara permanen.
/// Disimpan maksimal N versi terakhir per workspace (dipangkas saat menyimpan).
model PrdVersion {
  id          String   @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  fullPrdMd   String
  note        String?
  createdAt   DateTime @default(now())

  @@index([workspaceId, createdAt])
}

/// Percakapan chat untuk menyusun prototype secara iteratif.
/// Terpisah dari Workspace agar chat bisa ada sebelum project dibuat.
model ChatThread {
  id          String        @id @default(uuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String?
  workspace   Workspace?    @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  title       String        @default("Percakapan baru")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  messages    ChatMessage[]

  @@index([userId, updatedAt])
}

/// Percakapan Konsultasi AI (arsitektur & tech stack). Terpisah dari chat
/// prototype agar riwayat & tujuannya tidak tercampur.
model ConsultThread {
  id          String           @id @default(uuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String?
  workspace   Workspace?       @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  title       String           @default("Konsultasi baru")
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  messages    ConsultMessage[]

  @@index([userId, updatedAt])
}

model ConsultMessage {
  id        String        @id @default(uuid())
  threadId  String
  thread    ConsultThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  role      String        // 'user' | 'assistant'
  content   String
  createdAt DateTime      @default(now())

  @@index([threadId, createdAt])
}

model ChatMessage {
  id        String     @id @default(uuid())
  threadId  String
  thread    ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  role      String     // 'user' | 'assistant'
  content   String
  createdAt DateTime   @default(now())

  @@index([threadId, createdAt])
}

model ApiKey {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  keyHash     String    @unique
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())
}

/// Library tema lintas-project — fitur ENTERPRISE.
/// Berbeda dari `Workspace.themeTokensJson` (tema satu project), tema di sini
/// dapat diterapkan ke project mana pun milik pengguna.
model SavedTheme {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  tokens      Json     // ThemeTokens: warna, font, baseSize, radius
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, name])
  @@index([userId])
}

/// Template PRD siap pakai — fitur berbayar (STARTER ke atas).
/// Menghemat token: ide dasar, stack, dan kategori sudah terisi sehingga
/// wizard tidak mulai dari nol. Dikelola admin lewat seed / Prisma Studio.
model Template {
  id          String   @id @default(uuid())
  slug        String   @unique
  title       String
  description String
  /// Kategori untuk filter di galeri: 'saas' | 'ecommerce' | 'mobile' | 'internal' | ...
  category    String
  /// Emoji atau nama ikon lucide untuk ditampilkan di kartu.
  icon        String   @default("Sparkles")
  /// Ide awal (starter prompt) yang mengisi field "ide aplikasi" di wizard.
  idea        String
  /// Tech stack awal; kosong = biarkan AI memilih.
  techStack   String[] @default([])
  locale      String   @default("id")
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([isActive, sortOrder])
}

/// Status rilis sebuah fitur. Fitur bisa dibangun penuh tapi masih
/// ditampilkan "soon" (Segera Hadir) atau disembunyikan dari UI.
enum FeatureStatus {
  /// Bisa dipakai penuh dan tampil di navigasi.
  LIVE
  /// Tampil sebagai "Segera Hadir"; akses langsung dialihkan. Build tetap ada.
  SOON
  /// Tidak muncul di navigasi/landing; hanya bisa lewat allowlist admin.
  HIDDEN
}

/// Flag rilis fitur — dikelola admin dari /admin. Memungkinkan mematikan /
/// menyembunyikan fitur yang backend & frontend-nya sudah jadi tanpa deploy.
model FeatureFlag {
  id          String        @id @default(uuid())
  /// Kunci stabil, mis. "consult" | "chat".
  key         String        @unique
  label       String
  description String?
  status      FeatureStatus @default(SOON)
  updatedAt   DateTime      @updatedAt
  createdAt   DateTime      @default(now())

  @@index([status])
}

model PaymentConfig {
  id                  String   @id @default(uuid())
  provider            String
  isActive            Boolean  @default(false)
  isProduction        Boolean  @default(false)
  merchantId          String?
  clientKey           String
  serverKeyEncrypted  String   @db.Text
  webhookSecret       String?
  updatedAt           DateTime @updatedAt
}

model Voucher {
  id              String    @id @default(uuid())
  code            String    @unique
  discountPercent Int?
  discountAmount  Int?
  validUntil      DateTime?
  maxUses         Int       @default(100)
  usedCount       Int       @default(0)
  createdAt       DateTime  @default(now())
}

model Transaction {
  id               String       @id @default(uuid())
  userId           String
  user             User         @relation(fields: [userId], references: [id])
  amount           Int
  planType         PlanType
  billingCycle     BillingCycle
  status           String
  paymentGatewayId String?
  /// Referensi dari gateway (mis. Snap token Midtrans / invoice id Xendit)
  /// untuk rekonsiliasi. `order_id` yang dikirim = Transaction.id.
  paymentRef       String?
  /// Payload mentah notifikasi webhook terakhir (jejak audit).
  gatewayPayload   Json?
  createdAt        DateTime     @default(now())
}

model AiConfig {
  id            String   @id @default(uuid())
  mindmapModel  String   @default("OpenCodeCombo")
  prdModel      String   @default("OpenCodeCombo")
  systemPrompt  String   @default("You are an expert product architect.")
  updatedAt     DateTime @updatedAt
}

model AiUsage {
  id               String   @id @default(uuid())
  userId           String?
  kind             String   // 'mindmap'|'prd'|'questions'|'tasks'|'styleguide'|'techstack'|'prototype'|'chat'
  model            String
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  totalTokens      Int      @default(0)
  costUsd          Float    @default(0)
  createdAt        DateTime @default(now())

  @@index([createdAt])
  @@index([kind])
}